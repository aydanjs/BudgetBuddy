PORT=8080
PLAID_ENV=sandbox
PLAID_CLIENT_ID=PASTE_PLAID_CLIENT_ID_HERE
PLAID_SECRET=PASTE_SANDBOX_SECRET_HERE
DATABASE_URL=postgresql://budgetbuddy:password@localhost:5432/budgetbuddy
DATABASE_SSL=false
TOKEN_ENCRYPTION_KEY=PASTE_LONG_RANDOM_ENCRYPTION_SECRET_HERE
SESSION_SECRET=PASTE_LONG_RANDOM_SESSION_SECRET_HERE
APP_BUNDLE_ID=com.aydanjs.BudgetBuddyFinance
# Add these after the hosted API and OAuth domain exist:
# PLAID_REDIRECT_URI=https://YOUR_DOMAIN/plaid/oauth
# PLAID_WEBHOOK_URL=https://YOUR_API_DOMAIN/api/plaid/webhook
ALLOW_DEVELOPMENT_LOGIN=true
# Set to true only after Investments and Liabilities have been approved in
# Plaid and you are ready to collect consent on newly connected accounts.
PLAID_PORTFOLIO_PRODUCTS_ENABLED=false
